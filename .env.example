# ---------------------------------------------------------------------------
# Ark — Fantasy Football Hub
# Copy this file to `.env` and fill it in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Data source: "yahoo" (scrape your real league) or "demo" (bundled fake league)
FF_PROVIDER=demo

# Express API port
PORT=8787

# Network interface to bind. The default keeps Ark reachable only from this
# machine, which matters because the sync endpoint drives a browser holding
# your live Yahoo session. Change it only if you know you want that exposed.
HOST=127.0.0.1


# --- Your Yahoo league ------------------------------------------------------
# League id is the number in your league URL:
#   https://football.fantasysports.yahoo.com/f1/123456   ->   123456
YAHOO_LEAGUE_ID=

# Season year. Leave blank to use the current NFL season.
YAHOO_SEASON=

# Your own team id within the league (the number in your team's URL).
# Used to highlight "your team" throughout the hub. Optional.
YAHOO_TEAM_ID=


# --- Browser used to reach Yahoo -------------------------------------------
# Yahoo has closed new Fantasy OAuth app registrations, so Ark drives a real
# Chrome window that YOU log into once. The login is stored in a persistent
# browser profile on disk (see BROWSER_PROFILE_DIR) and reused after that.

# Use your installed browser instead of Playwright's bundled Chromium.
# Recommended: "chrome". Other options: "msedge", "chrome-beta", or blank
# to use Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome

# Explicit path to a browser executable. Overrides BROWSER_CHANNEL when set.
# Only needed if Ark can't find your browser automatically.
BROWSER_PATH=

# Where the logged-in browser profile is stored. Treat this like a password:
# anyone with this directory can act as you on Yahoo.
BROWSER_PROFILE_DIR=.browser-profile

# Show the browser window during scrapes. "1" is useful for debugging or when
# Yahoo asks for a re-login / captcha; "0" scrapes quietly in the background.
BROWSER_HEADED=0

# Milliseconds to wait between page loads while scraping. Be polite to Yahoo —
# this is your own account and hammering it is a good way to get logged out.
SCRAPE_DELAY_MS=1200

# Page navigation timeout in milliseconds.
SCRAPE_TIMEOUT_MS=45000


# --- Caching ----------------------------------------------------------------
# Where normalized league data and raw captures are written.
CACHE_DIR=.cache

# How long (seconds) the API serves cached league data before it is considered
# stale. Refresh happens via `npm run yahoo:sync`, not automatically.
CACHE_TTL_SECONDS=900
